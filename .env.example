# Rename this file to .env and add your OpenAI API key
# IMPORTANT: Never commit your actual .env file with real API keys to version control!

# Your OpenAI API key (get one from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI model to use (default: gpt-4.1-mini)
OPENAI_MODEL=gpt-4.1-mini

# Server port (default: 3000)
PORT=3000
